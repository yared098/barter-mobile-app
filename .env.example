# Copy this file to .env and fill in real values.

# Android emulator:  http://10.0.2.2:3000/api/v1
# iOS simulator:     http://localhost:3000/api/v1
# Real device WiFi:  http://<YOUR_LAN_IP>:3000/api/v1
# Production:        https://api.barterethio.com/api/v1
API_BASE_URL=http://10.0.2.2:3000/api/v1

# MUST match GOOGLE_CLIENT_ID in backend .env
GOOGLE_WEB_CLIENT_ID=

APP_NAME=Barter Ethio
APP_TAGLINE=Trade what you have

SHOW_DEV_HELPERS=false
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
