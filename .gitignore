# ═══════════════════════════════════════════════════════
#  FIREBASE SECRETS — NEVER COMMIT
# ═══════════════════════════════════════════════════════

# Firebase Android config (contains API keys)
android/app/google-services.json

# Firebase iOS config (contains API keys)
ios/Runner/GoogleService-Info.plist

# Firebase generated Dart config (contains all platform keys)
lib/firebase_options.dart

# Firebase Admin SDK service account (contains PRIVATE KEY)
firebase-service-account*.json
*-firebase-adminsdk-*.json

# Firebase project config
.firebase/
firebase-debug.log
firebase-debug.*.log

# Firebase Cloud Messaging private keys
**/.firebase/**/*.json

# ═══════════════════════════════════════════════════════
#  ENVIRONMENT / SECRETS
# ═══════════════════════════════════════════════════════

.env
.env.*
!.env.example

# API keys, credentials
secrets/
*.secret
*.pem
*.key
*.p12

# ═══════════════════════════════════════════════════════
#  MISCELLANEOUS
# ═══════════════════════════════════════════════════════

*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ═══════════════════════════════════════════════════════
#  INTELLIJ / IDE
# ═══════════════════════════════════════════════════════

*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ═══════════════════════════════════════════════════════
#  FLUTTER / DART
# ═══════════════════════════════════════════════════════

**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/generated_plugin_registrant.dart

# ═══════════════════════════════════════════════════════
#  SYMBOLICATION / OBFUSCATION
# ═══════════════════════════════════════════════════════

app.*.symbols
app.*.map.json

# ═══════════════════════════════════════════════════════
#  ANDROID BUILD ARTIFACTS
# ═══════════════════════════════════════════════════════

/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/captures/
/android/local.properties
/android/key.properties
*.jks
*.keystore
!debug.keystore

# ═══════════════════════════════════════════════════════
#  iOS BUILD ARTIFACTS
# ═══════════════════════════════════════════════════════

ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
*.xcuserstate

# ═══════════════════════════════════════════════════════
#  WEB BUILD ARTIFACTS
# ═══════════════════════════════════════════════════════

web/firebase-messaging-sw.js
# Note: firebase-messaging-sw.js contains Firebase config — 
#       generate it at build time or commit a template instead

# ═══════════════════════════════════════════════════════
#  WIDGET PREVIEW
# ═══════════════════════════════════════════════════════

.widget_preview/

# ═══════════════════════════════════════════════════════
